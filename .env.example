# Copy to .env.local and fill in. All values are PUBLIC (bundled into the frontend) — never put private API keys here.

# Production URL, used for canonical/OG tags and sitemap.xml (no trailing slash)
VITE_SITE_URL=

# Real contact email (enables the "open email draft" fallback and footer link)
VITE_CONTACT_EMAIL=

# Form backend endpoint that accepts a JSON POST (e.g. a Formspree/Basin form URL). Optional.
VITE_FORM_ENDPOINT=

# Social profile URLs. Links are hidden while empty.
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=

# Only for GitHub Pages project sites, e.g. /redoak-markets-case-study/ . Leave empty for Vercel.
VITE_BASE=
